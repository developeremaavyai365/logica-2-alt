# Copy to .env.local (Vite convention) and fill in real values. Never commit .env.local.

# Base URL of the Logica backend (see /backend). Local dev default matches
# `npm run start:dev` there. In production, point this at wherever the
# backend is actually deployed — the frontend build embeds this value at
# build time, so it must be set correctly before deploying.
VITE_API_URL=http://localhost:4000
