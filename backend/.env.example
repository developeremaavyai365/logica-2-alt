# Copy to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=4000

# Postgres
DATABASE_URL="postgresql://logica:logica_dev_password@localhost:5432/logica?schema=public"

# Redis (rate-limit store, refresh-token blacklist cache)
REDIS_URL="redis://localhost:6379"

# JWT (RS256) — generate with `npm run keys:generate`.
# Local dev: use the *_PATH pair, pointing at the gitignored files that
# command produces.
JWT_PRIVATE_KEY_PATH="./keys/jwt-private.pem"
JWT_PUBLIC_KEY_PATH="./keys/jwt-public.pem"
# Deploying somewhere with no persistent filesystem for keys/ (Railway,
# Render, most PaaS): set these two instead, to the raw PEM file contents
# with real newlines (most hosts support multi-line env vars in their
# dashboard) or literal \n if yours doesn't. If both pairs are set, these
# win over the *_PATH pair.
# JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
JWT_ACCESS_TOKEN_TTL="15m"
JWT_REFRESH_TOKEN_TTL_DAYS=30

# CORS — comma-separated list of allowed origins, no wildcard
CORS_ORIGINS="https://logicainfoway.com,http://localhost:5173"

# Base URL of the frontend — used to build the links sent in verification/
# reset emails. Defaults to localhost:5173 if unset.
FRONTEND_URL="http://localhost:5173"

# Cookies
REFRESH_COOKIE_NAME="logica_rt"
COOKIE_DOMAIN="localhost"

# Mail (verification / password reset)
# provider = "console": links are logged to the server terminal, nothing sent.
# provider = "resend": real emails via resend.com — needs RESEND_API_KEY.
#   Without a verified sending domain on your Resend account, MAIL_FROM must
#   be "onboarding@resend.dev" and you can only send TO the email address
#   you signed up to Resend with (their sandbox restriction). Verify your
#   own domain in the Resend dashboard to send from/to anything.
MAIL_FROM="no-reply@logicainfoway.com"
MAIL_PROVIDER="console"
RESEND_API_KEY=""

# Password hashing (argon2id params — defaults are OWASP-recommended minimums)
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
